flowchart TD
  MIC["瀏覽器麥克風<br/>AudioWorklet → 16 kHz PCM16<br/>20 ms / 塊"] -->|"WS binary 0x01"| Q["伺服器佇列（記憶體）"]
  Q --> RAW["原始 VAD<br/>（輸入能量）"]
  Q --> ISO["PureSound SDK<br/>dpcrn_curriculum_v2<br/>STFT 512 / hop 10 ms / 前瞻 30 ms<br/>0.9 增強 + 0.1 原聲"]
  ISO --> CV["乾淨 VAD<br/>（分離後能量 + 尾音）"]
  CAM["影像：追蹤快照<br/>ROI 內有人？距離？<br/>保持 0.75 s"] --> XC
  CV --> XC{"影像交叉確認<br/>每 20 ms"}
  RAW --> XC
  XC -->|"一致 / 安靜"| OUT["輸出不變"]
  XC -->|"漏音 / 超出範圍"| ATT["壓低 -40 dB<br/>不算說話"]
  XC -->|"漏收"| REC["增強 30% + 原聲 70%<br/>算說話"]
  XC -->|"只看聲音"| OUT
  OUT --> WSO["WS binary 0x02<br/>乾淨音軌回瀏覽器"]
  ATT --> WSO
  REC --> WSO
  XC -->|"校正後說話"| SM["狀態機<br/>進場 = 說話開頭 + 近距離有人"]
