flowchart TD
  subgraph B["瀏覽器（static/index.html）"]
    CAM["getUserMedia 640×480 + 麥克風"] --> JPG["每 1/fps 秒：縮到高 480 px → JPEG q0.7（原始方向，不鏡像）"]
    MIC["AnalyserNode RMS（每 50 ms）"] --> VAD["自適應噪音底 VAD：thr = max(floor·vad_k, vad_min)，hang 400 ms"]
  end
  JPG -- "WS {type:frame, speech, data}" --> SLOT["伺服器 worker：只處理最新一張（舊的丟棄）"]
  VAD -- "WS {type:vad}（改變時）" --> SP["tracker.set_speech()"]
  SLOT --> DEC["cv2.imdecode（只在記憶體）"]
  DEC --> MG{"移動閘門<br/>畫面幾乎沒變？"}
  MG -- "是" --> REUSE["沿用上一次的 detections"]
  MG -- "否" --> CROP["face_roi + crop_margin 裁切 → 寬 ≤ max_width(320) 縮小"]
  CROP --> YN["YuNet（score ≥ 0.5，NMS 0.3）→ 框 + 5 點 + frontal 分數"]
  YN --> TH{"embedding 節流<br/>可重用？"}
  TH -- "重用" --> DETS
  TH -- "重算" --> SF["SFace 128-d：embed_backend = fp32 / int8 / npu(TFLite)"]
  SF --> DETS["Detection 清單"]
  DETS --> PE{"pose_enabled"}
  PE -- "是" --> MN["MoveNet MultiPose（pose_roi + margin，長邊 256）→ fuse 臉+身體"]
  PE -- "否" --> AP
  MN --> AP{"kalman 模式"}
  AP -- "是" --> HS["軀幹 HSV 直方圖（12×4）"]
  AP -- "否" --> TR
  HS --> TR
  REUSE --> TR
  SP --> TR
  TR["tracker.update()：ROI 規則 → 信心分組 → 距離估計（可選）"] --> L4["Layer 4 追蹤：legacy（貪婪 cos+IoU）／kalman（Kalman + Hungarian + 外觀 + coast）"]
  L4 --> L3["Layer 3 意圖：rules（在 ROI 待滿 join_seconds）／score（意圖分數 EMA）→ 加入／降級"]
  L3 --> L2["Layer 2 在場：rules（連續幀計數 + 逾時）／hmm（每人 log-odds + 聲音偏移）"]
  L2 --> NG["NEW_GROUP 檢查"]
  NG --> SM["狀態機 _evaluate：ACTIVE / IDLE / MAYBE_AWAY / AWAY / ENDED"]
  TICK["ticker 每 0.5 s：tick()"] --> SM
  SM --> OUT["JSON state（tracks、事件 log、p_group…）+ 建議 fps → 瀏覽器疊圖與面板"]
